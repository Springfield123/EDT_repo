&CONTROL
    calculation = 'scf',
    restart_mode = 'from_scratch',
    prefix = 'pwscf',
    outdir = './qe_out',
    pseudo_dir = 'C:\Users\agahu\Dropbox\NRC\EDT\qe_input\pseudo',
    verbosity = 'high',
    wf_collect = .true.,
/
&SYSTEM
    ibrav = 0,
    nat = 2,
    ntyp = 1,
    ecutwfc =100.0,
    nbnd = 48,
    input_dft='pbe',
    exxdiv_treatment='gygi-baldereschi',
    x_gamma_extrapolation = .true.,
    occupations='smearing',
    smearing='methfessel-paxton',
    degauss=0.05,
/
&ELECTRONS
    mixing_beta=0.1,
    conv_thr = 1.0d-8,
    electron_maxstep = 200,
/
