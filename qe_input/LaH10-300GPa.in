 &control
    calculation = 'vc-relax'
    nstep=1000
    etot_conv_thr=1.0D-5
    forc_conv_thr=1.0D-4
    pseudo_dir='/home/ahu/pseudopotentials/'
 /
 &system    
    ibrav=  0, nat=  44, ntyp= 2,
    ecutwfc =100.0,  nbnd = 200
    input_dft='pbe',
    exxdiv_treatment='gygi-baldereschi'
    x_gamma_extrapolation = .true.
    occupations='smearing', smearing='methfessel-paxton', degauss=0.05
 /
 &electrons
 mixing_beta=0.1
 conv_thr  =  1.0d-7
 /
 &IONS
 ion_dynamics='bfgs'
 ion_positions='from_input'
 /
 &CELL
 cell_dynamics='bfgs'
 press=3000.0
 press_conv_thr=0.01
 cell_dofree='all'
 /
