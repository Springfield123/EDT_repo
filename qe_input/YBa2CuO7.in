 &control
    calculation = 'relax'
    pseudo_dir='/home/ahu/pseudopotentials/'
 /
 &system
    ibrav=  0, nat=  13, ntyp= 4,
    ecutwfc =100.0,  nbnd = 100
    input_dft='pbe',
    exxdiv_treatment='gygi-baldereschi',
    x_gamma_extrapolation = .true.
    occupations='smearing', smearing='methfessel-paxton', degauss=0.08
 /
 &electrons
    conv_thr =  1.0e-7
    scf_must_converge=.false.
 /
 &IONS
 ion_dynamics='bfgs'
 /
 &CELL
 cell_dynamics='bfgs'
 press=300.000
 press_conv_thr=0.001
 cell_dofree='all'
 /
