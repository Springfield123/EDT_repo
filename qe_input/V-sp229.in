 &control
    calculation = 'relax'
    nstep=1000
    etot_conv_thr=1.0D-5
    forc_conv_thr=1.0D-4
    pseudo_dir='/home/ahu/pseudopotentials/'
 /
&SYSTEM
    ibrav = 0,
    nat = 2, ntyp = 1,
    ecutwfc =100.0,  nbnd = 50
    input_dft='pbe',
    exxdiv_treatment='gygi-baldereschi'
    x_gamma_extrapolation = .true.
    occupations='smearing', smearing='methfessel-paxton', degauss=0.05
 /
&electrons
 mixing_beta=0.1
 conv_thr  =  1.0d-7
 /
 &IONS
 ion_dynamics='bfgs'
 ion_positions='from_input'
 /
 &CELL
 cell_dynamics='bfgs'
 press=3000.0
 press_conv_thr=0.01
 cell_dofree='all'
 /
ATOMIC_SPECIES
   V   50.94151   V.pbe-spnl-kjpaw_psl.1.0.0.UPF
CELL_PARAMETERS
     5.72209070518301      0.00000000000000      0.00000000000000
     0.00000000000000      5.72209070518301      0.00000000000000
     0.00000000000000      0.00000000000000      5.72209070518301
ATOMIC_POSITIONS crystal
   V    0.00000   0.00000   0.00000   
   V    0.50000   0.50000   0.50000   
K_POINTS automatic
8  8  8   0 0 0
