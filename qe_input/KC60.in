 &control
    calculation = 'relax'
    pseudo_dir='/home/ahu/pseudopotentials/'
 /
 &system
    ibrav=  0, nat=  63, ntyp= 2,
    ecutwfc =70.0,  nbnd = 280
    input_dft='pbe'
    exxdiv_treatment='gygi-baldereschi'
    x_gamma_extrapolation = .true.
    occupations='smearing', smearing='methfessel-paxton', degauss=0.05
 /
 &electrons
    conv_thr =  1.0e-7
    mixing_beta=0.1
 /
 &IONS
 ion_dynamics='bfgs'
 ion_positions='from_input'
 /
 &CELL
 cell_dynamics='bfgs'
 press=300.000
 press_conv_thr=0.001
 cell_dofree='all'
 /
